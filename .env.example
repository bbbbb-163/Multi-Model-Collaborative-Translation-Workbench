# Domain only: no https://, port, slash, or www unless that is your assigned name.
DOMAIN=mstar.chat

# Use a unique image tag for each release, and retain the old image for rollback.
APP_IMAGE=mstar-workbench:initial
NODE_IMAGE=node:24-bookworm-slim
CADDY_IMAGE=caddy:2-alpine

# Relative to compose.yaml. This directory survives container replacement.
WORKBENCH_DATA_DIR=./runtime/data

# Existing resource limits; these are not billing or subscription settings.
WORKBENCH_MAX_STORAGE_MB=1024
WORKBENCH_MAX_RUNS_PER_OWNER=3
WORKBENCH_MAX_TOTAL_RUNS=24
